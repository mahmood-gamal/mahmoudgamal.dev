<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Engine-agnostic game logic. This project deliberately uses the plain .NET SDK
    with no GodotSharp reference, so any `using Godot;` here fails to compile.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Ragna.Core</RootNamespace>
    <AssemblyName>Ragna.Core</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
